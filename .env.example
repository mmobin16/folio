# Local development only. Prisma CLI itself always uses prisma/dev.db.
# The app reads this when TURSO_DATABASE_URL is empty, and resolves it to prisma/dev.db.
DATABASE_URL="file:./dev.db"

# Production database on Vercel. Create a free Turso database and set both values
# in the Vercel project. Leave them empty for local SQLite.
TURSO_DATABASE_URL=""
TURSO_AUTH_TOKEN=""
